# Telegram bot token from BotFather.
# Example format: 123456789:AA... but do not paste production secrets into this file.
TELEGRAM_BOT_TOKEN=replace_me

# Private channel identifier.
# Use either @channel_username or a numeric id like -1001234567890.
TELEGRAM_CHANNEL_ID=-1001234567890

# Telegram admin credentials for bot management.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
# Numeric Telegram user id for password-less admin access, for example 123456789.
ADMIN_TELEGRAM_ID=

# Subscription settings.
SUBSCRIPTION_PRICE_STARS=250
SUBSCRIPTION_DURATION_DAYS=30
WARNING_DAYS=3
RECURRING_PAYMENTS_ENABLED=false
SUBSCRIPTION_NAME=Доступ в приватный канал
SUBSCRIPTION_DESCRIPTION=Оплата доступа к приватному Telegram-каналу
WELCOME_TEXT=Оформите подписку, и бот выдаст доступ в приватный канал.
# Support username without @.
SUPPORT_USERNAME=

# Runtime and deployment settings.
SESSION_SECRET=change_me_too
PORT=3000
APP_TIMEZONE=Europe/Saratov
BASE_URL=http://localhost:3000
AUTO_CREATE_INVITE_LINK=true
CHANNEL_INVITE_LINK=
POLL_TIMEOUT_SECONDS=25
SERVICE_CHECK_INTERVAL_MS=60000
# Relative Linux-safe default path for the JSON store.
DATA_FILE_PATH=data/db.json
